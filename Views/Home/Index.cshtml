@model ToyStoreManagement.ViewModels.HomeViewModel

@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}


<section class="home-hero">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <span class="badge bg-warning text-dark mb-3">
                    THẾ GIỚI ĐỒ CHƠI
                </span>

                <h1>
                    Khám phá thế giới
                    <strong>đồ chơi tuyệt vời</strong>
                </h1>

                <p>
                    Những sản phẩm thú vị, an toàn
                    và phù hợp với mọi độ tuổi.
                </p>

                <a href="#" class="btn btn-primary">
                    Mua sắm ngay
                </a>
            </div>

            <div class="col-lg-6">
                <img src="https://placehold.co/800x500"
                     class="img-fluid"
                     alt="Toy Store" />
            </div>

        </div>
    </div>
</section>

<section class="category-section py-5">

    <div class="container">

        <div class="section-heading">
            <h2>Khám phá danh mục</h2>
            <a href="#">
                Xem tất cả
            </a>
        </div>

        <div class="row g-4">

            @foreach (var category in Model.Categories)
            {
                <div class="col-6 col-md-4 col-lg-3">

                    <div class="category-card">

                        <img src="@category.ImageUrl"
                             class="img-fluid"
                             alt="@category.Name" />

                        <h5>
                            @category.Name
                        </h5>

                        <small>
                            @category.ProductCount
                        </small>

                    </div>

                </div>
            }

        </div>

    </div>

</section>

<section class="product-section py-5">

    <div class="container">

        <div class="section-heading">

            <h2>Sản phẩm mới</h2>

            <a href="#">
                Xem tất cả
            </a>

        </div>

        <div class="row g-4">

            @foreach (var product in Model.NewProducts)
            {
                <div class="col-6 col-md-4 col-lg-3">

                    @Html.Partial(
                        "_ProductCard",
                        product
                    )

                </div>
            }

        </div>

    </div>

</section>

<section class="product-section py-5">

    <div class="container">

        <div class="section-heading">

            <h2>Sản phẩm mới</h2>

            <a href="#">
                Xem tất cả
            </a>

        </div>

        <div class="row g-4">

            @foreach (var product in Model.NewProducts)
            {
                <div class="col-6 col-md-4 col-lg-3">

                    @Html.Partial(
                        "_ProductCard",
                        product
                    )

                </div>
            }

        </div>

    </div>

</section>

<section class="promotion-section py-5">

    <div class="container">

        <div class="row g-4">

            @foreach (var promotion in Model.Promotions)
            {
                <div class="col-md-6">

                    <div class="promotion-card">

                        <img src="@promotion.ImageUrl"
                             class="img-fluid"
                             alt="@promotion.Title" />

                        <div class="promotion-content">

                            <h3>
                                @promotion.Title
                            </h3>

                            <p>
                                @promotion.Description
                            </p>

                            <a href="@promotion.ButtonUrl"
                               class="btn btn-primary">
                                @promotion.ButtonText
                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>

    </div>

</section>




